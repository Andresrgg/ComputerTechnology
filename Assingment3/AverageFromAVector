.syntax unified
.cpu cortex-m0plus
.thumb

.thumb_func
.global asm_main
.type asm_main, %function

asm_main:
    push {r4, lr}
    bl stdio_init_all

loop:
    ldr r0, =my_array
    movs r1, #8
    bl average

    movs r1, r0
    ldr r0, =message_str
    bl printf

    ldr r0, =1000
    bl sleep_ms

    b loop

average:
    movs r2, #0

loop_ave:
    ldr r3, [r0]
    adds r2, r2, r3
    adds r0, r0, #4
    subs r1, r1, #1
    cmp r1, #0
    bne loop_ave

    movs r0, r2
    lsrs r0, r0, #3
    bx lr

.data
.align 2
message_str: .asciz "Average value %d\n"

.align 2
my_array: .word 10, 20, 30, 40, 50, 60, 70, 80
