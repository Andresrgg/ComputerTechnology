.syntax unified
.cpu cortex-m0plus
.thumb

.thumb_func
.global mainS
.type mainS, %function

.equ LED0, 0
.equ LED1, 1
.equ BUT1, 2
.equ BUT2, 3
.equ GPIO_OUT, 1
.equ GPIO_IN, 0

mainS:
    push {r4, r5, r6, lr}

    bl stdio_init_all

    movs r0, #LED0
    bl link_gpio_init
    movs r0, #LED0
    movs r1, #GPIO_OUT
    bl link_gpio_set_dir

    movs r0, #LED1
    bl link_gpio_init
    movs r0, #LED1
    movs r1, #GPIO_OUT
    bl link_gpio_set_dir

    movs r0, #BUT1
    bl link_gpio_init
    movs r0, #BUT1
    movs r1, #GPIO_IN
    bl link_gpio_set_dir
    movs r0, #BUT1
    bl link_gpio_pull_up

    movs r0, #BUT2
    bl link_gpio_init
    movs r0, #BUT2
    movs r1, #GPIO_IN
    bl link_gpio_set_dir
    movs r0, #BUT2
    bl link_gpio_pull_up

loop:
    movs r0, #BUT1
    bl link_gpio_get
    movs r5, r0 

    movs r0, #BUT2
    bl link_gpio_get
    movs r6, r0 

    cmp r5, r6
    beq delay

    cmp r5, #0
    beq turn_on

    cmp r6, #0
    beq turn_off

    b delay

turn_off:
    movs r0, #LED0
    movs r1, #0
    bl link_gpio_put

    movs r0, #LED1
    movs r1, #0
    bl link_gpio_put
    b delay

turn_on:
    movs r0, #LED0
    movs r1, #1
    bl link_gpio_put

    movs r0, #LED1
    movs r1, #1
    bl link_gpio_put

delay:
    movs r0, #55
    bl sleep_ms
    b loop
