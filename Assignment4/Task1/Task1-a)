#include "pico/stdlib.h"

#define LED   0
#define B_ON  4
#define B_OFF 5

int main() {
    stdio_init_all();

    gpio_init(LED);
    gpio_set_dir(LED, GPIO_OUT);

    gpio_init(B_ON);
    gpio_set_dir(B_ON, GPIO_IN);
    gpio_pull_up(B_ON);

    gpio_init(B_OFF);
    gpio_set_dir(B_OFF, GPIO_IN);
    gpio_pull_up(B_OFF);

    while (true) {
        bool on = gpio_get(B_ON);
        bool off = gpio_get(B_OFF);
        if (on && !off) {
            gpio_put(LED, 1);
        } else if (!on && off) {
            gpio_put(LED, 0);
        }

        sleep_ms(50);
    }

    return 0;
}
